# =====================================================================
# Variáveis de ambiente — SOMENTE NOMES E EXEMPLOS. Nenhum valor real aqui.
#
# Onde cada valor fica:
#   • Desenvolvimento (seu computador): copie para .env e preencha.
#   • Testes automáticos: .env.test (veja a seção TESTES no fim).
#   • Prévia e Produção: painel da Vercel › seu projeto › Settings › Environment Variables,
#     marcando o ambiente certo (Production / Preview). NUNCA cole senhas ou chaves em conversas ou no código.
#
# Chaves privadas jamais usam o prefixo NEXT_PUBLIC_ (esse prefixo deixa o valor visível no navegador).
# =====================================================================

# --- Aplicação -------------------------------------------------------
# development (seu computador) | staging (prévias) | production (site oficial)
APP_ENV=development
# Endereço público. Produção: https://seudominio.com.br  · Prévia: deixe vazio (usa o endereço da prévia)
APP_URL=http://localhost:3000
SESSION_TTL_DAYS=30

# --- Banco de dados (PostgreSQL) -------------------------------------
# Vercel + Neon: as duas variáveis abaixo são criadas AUTOMATICAMENTE pela integração do banco.
# DATABASE_URL = conexão "pooled" (usada pelo site) · DATABASE_URL_UNPOOLED = conexão direta (migrações)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/ombrelones
DATABASE_URL_UNPOOLED=postgresql://usuario:senha@localhost:5432/ombrelones
# Conexões por instância (padrão: 10 no computador, 5 na Vercel)
DB_POOL_SIZE=

# --- Dados iniciais (primeira publicação) -----------------------------
# Cria o primeiro usuário Adm se ainda não existir. Defina SÓ no painel da Vercel e APAGUE depois do 1º acesso.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# true apenas em demonstração local (nunca em produção)
SEED_DEMO=false

# --- Arquivos (fotos e documentos) ------------------------------------
# local = disco (seu computador) · vercel-blob = Vercel Blob (prévias e produção)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=storage/uploads
STORAGE_PRIVATE_DIR=storage/private
# Na Vercel: "blob" faz o navegador enviar fotos/PDFs direto ao Blob (sem o limite de 4,5 MB por envio)
NEXT_PUBLIC_UPLOAD_MODE=
# Criadas pela Vercel ao conectar os stores (Storage › Blob). Store PÚBLICO (fotos):
BLOB_READ_WRITE_TOKEN=
# Store PRIVADO (NF, boletos, comprovantes) — ao conectar, use o prefixo PRIVATE_BLOB:
PRIVATE_BLOB_READ_WRITE_TOKEN=
# Domínio de um CDN próprio de imagens (opcional)
IMAGE_CDN_HOST=

# --- Tarefas agendadas ------------------------------------------------
# Texto aleatório (16+ caracteres) criado por você no painel da Vercel; protege /api/cron/*
CRON_SECRET=

# --- Consulta de CNPJ (PENDENTE — necessária para o cadastro de empresas) ----
CNPJ_PROVIDER=
CNPJ_API_URL=
CNPJ_API_KEY=

# --- E-mail transacional (PENDENTE — necessário para confirmar cadastros) ----
# resend | ses | smtp
EMAIL_PROVIDER=
EMAIL_FROM="[NOME DA MARCA] <nao-responda@suamarca.com.br>"
EMAIL_API_KEY=
ADMIN_NOTIFICATION_EMAIL=

# --- Fretes (PENDENTE — sem ele, o pedido segue por cotação manual) -----
SHIPPING_PROVIDER=
MELHORENVIO_API_URL=https://sandbox.melhorenvio.com.br
MELHORENVIO_TOKEN=
SHIPPING_ORIGIN_ZIP=

# --- Pagamentos Pix, boleto e cartão (PENDENTE) ------------------------
PAYMENT_PROVIDER=
PAGARME_API_URL=https://api.pagar.me/core/v5
PAGARME_SECRET_KEY=
PAGARME_PUBLIC_KEY=
PAGARME_WEBHOOK_USER=
PAGARME_WEBHOOK_PASSWORD=

# --- ERP (PENDENTE) ----------------------------------------------------
ERP_PROVIDER=
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REFRESH_TOKEN=

# --- Mercado Livre (recebimentos) — PENDENTE ----------------------------
# Endereço de retorno no app do ML: ${APP_URL}/api/admin/integracoes/mercadolivre/callback
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
# Chave para criptografar tokens no banco (32 bytes em base64). Gere com: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# --- Contato público (aparece no site) ---------------------------------
# Somente dígitos, ex.: 5511999999999
NEXT_PUBLIC_WHATSAPP=

# =====================================================================
# TESTES (arquivo .env.test, nunca o banco real)
# Banco DESCARTÁVEL usado pelo teste de concorrência de estoque; vazio = teste ignorado.
TEST_DATABASE_URL=
# =====================================================================
