# =====================================================================
# Variáveis de ambiente — copie para .env e preencha.
# NUNCA versione o .env. Chaves privadas jamais usam o prefixo NEXT_PUBLIC_.
# =====================================================================

# --- Aplicação -------------------------------------------------------
APP_ENV=development                      # development | staging | production
APP_URL=http://localhost:3000            # URL pública (links de e-mail, webhooks, sitemap)
SESSION_SECRET=troque-por-32+-caracteres-aleatorios
SESSION_TTL_DAYS=30

# --- Banco de dados (PostgreSQL) -------------------------------------
DATABASE_URL=postgresql://usuario:senha@localhost:5432/ombrelones
DB_POOL_SIZE=10
# PRISMA_USE_ADAPTER=1   # só para rodar migrations onde o download de binários do Prisma é bloqueado
TEST_DATABASE_URL=                       # banco DESCARTÁVEL para testes de integração

# --- Seed ------------------------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO=false                          # true apenas em ambiente de demonstração

# --- Imagens ---------------------------------------------------------
IMAGE_CDN_HOST=                          # ex.: cdn.suamarca.com.br
STORAGE_PROVIDER=                        # local (dev/homologação) | s3 | r2  — s3/r2 PENDENTE
STORAGE_LOCAL_DIR=storage/uploads        # pasta usada quando STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Consulta de CNPJ ------------------------------------------------
CNPJ_PROVIDER=                           # cnpja | receitaws | serpro  (PENDENTE)
CNPJ_API_URL=
CNPJ_API_KEY=

# --- Fretes ----------------------------------------------------------
SHIPPING_PROVIDER=                       # melhorenvio  (PENDENTE)
MELHORENVIO_API_URL=https://sandbox.melhorenvio.com.br
MELHORENVIO_TOKEN=
SHIPPING_ORIGIN_ZIP=                     # CEP de expedição

# --- Pagamentos ------------------------------------------------------
PAYMENT_PROVIDER=                        # pagarme  (PENDENTE)
PAGARME_API_URL=https://api.pagar.me/core/v5
PAGARME_SECRET_KEY=                      # sk_test_… em homologação
PAGARME_PUBLIC_KEY=                      # pk_test_… (tokenização no navegador)
PAGARME_WEBHOOK_USER=                    # Basic Auth configurado no painel Pagar.me
PAGARME_WEBHOOK_PASSWORD=

# --- ERP -------------------------------------------------------------
ERP_PROVIDER=                            # bling  (PENDENTE)
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REFRESH_TOKEN=

# --- E-mail transacional --------------------------------------------
EMAIL_PROVIDER=                          # resend | ses | smtp  (PENDENTE)
EMAIL_FROM="[NOME DA MARCA] <nao-responda@suamarca.com.br>"
EMAIL_API_KEY=
ADMIN_NOTIFICATION_EMAIL=                # recebe solicitações de cotação

# --- Contato público (exibido no site) -------------------------------
NEXT_PUBLIC_WHATSAPP=                    # somente dígitos, ex.: 5511999999999

# Documentos financeiros (NF, boletos, comprovantes) — pasta PRIVADA, nunca servida publicamente
STORAGE_PRIVATE_DIR=storage/private

# Mercado Livre (recebimentos) — PENDENTE até configurar. Redirect URI no app do ML: ${APP_URL}/api/admin/integracoes/mercadolivre/callback
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
# Chave para criptografar tokens no banco (32 bytes em base64): openssl rand -base64 32
APP_ENCRYPTION_KEY=
